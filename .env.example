# Claude API (server only). Or run `ant auth login` locally instead.
ANTHROPIC_API_KEY=

# Supabase (server only). Leave blank to use the in-memory dev store + seed motions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the anonymous player cookie. Any long random string in production.
DEBATLE_COOKIE_SECRET=

# Protects POST /api/admin/openings.
DEBATLE_ADMIN_SECRET=

# Day 1 of Debatle (UTC). Days roll over at 00:00 UTC.
DEBATLE_EPOCH=2026-12-01

# Dev only: canned opponent + judge so the UI can be played without API calls.
# Ignored in production builds.
DEBATLE_MOCK_AI=

# Dev only: replaces today's motion with any text (in-memory store only).
DEBATLE_MOTION=

# Authorises the daily /api/cron/openings job (Vercel sends it as a Bearer token).
CRON_SECRET=

# Archive unlock: Google sign-in (Supabase Auth) + Stripe.
# Publishable key (sb_publishable_...), server-side only here; used for Google sign-in sessions.
SUPABASE_PUBLISHABLE_KEY=
# Stripe secret key (sk_test_... while testing, sk_live_... in production).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...), for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Google AdSense (public: these reach the browser). Leave blank to show no ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_JUDGING=
NEXT_PUBLIC_ADSENSE_SLOT_VERDICT=
# Shown on /privacy for data-deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=
